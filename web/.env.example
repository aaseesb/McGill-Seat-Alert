# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend, with a verified sending domain so alerts reach any address
RESEND_API_KEY=
RESEND_FROM="Seat Alert <alerts@yourdomain.com>"

# Public URL of the site, used in email links and sign-in redirects
SITE_URL=http://localhost:3000

# Random string; the scheduler sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Optional: self-hosted ntfy server
# NTFY_SERVER=https://ntfy.sh
